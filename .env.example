# Telegram Bot token from @BotFather (REQUIRED)
TELEGRAM_BOT_TOKEN=paste_your_bot_token_here

# Comma-separated Telegram numeric user IDs allowed to control the motors.
# Leave blank during first run, send /whoami to the bot, then paste your ID here.
ALLOWED_USER_IDS=

# Hardware mode: auto | three_drv | single_drv | simulate
HAPTIC_TOPOLOGY=auto

# Optional JSON hardware config path (defaults to auto-detecting Pi 5 wiring)
HAPTIC_CONFIG=

# Default auto-off safety timer in seconds (0 = hold until stop)
DEFAULT_AUTO_OFF_S=10
